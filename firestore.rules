rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write to subjects and their chapters
    match /subjects/{subjectId} {
      allow read, write: if true;
      
      match /chapters/{chapterId} {
        allow read, write: if true;
      }
    }

    // Allow read/write to vip_users
    match /vip_users/{userEmail} {
      allow read, write: if true;
    }

    // Allow read/write to registered students
    match /students/{studentId} {
      allow read, write: if true;
    }

    // Allow read/write to payment_requests (screenshot uploads and status)
    match /payment_requests/{requestId} {
      allow read, write: if true;
    }

    // Allow read/write to paid_notes (PDF notes uploaded by admin)
    match /paid_notes/{noteId} {
      allow read, write: if true;
    }
  }
}

