rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write to subjects and their chapters
    match /subjects/{subjectId} {
      allow read, write: if true;
      
      match /chapters/{chapterId} {
        allow read, write: if true;
      }
    }

    // Allow read/write to vip_users
    match /vip_users/{userEmail} {
      allow read, write: if true;
    }

    // Allow read/write to registered students
    match /students/{studentId} {
      allow read, write: if true;
    }

    // Allow read/write to payment_requests (screenshot uploads and status)
    match /payment_requests/{requestId} {
      allow read, write: if true;
    }

    // Allow read/write to paid_notes (PDF notes uploaded by admin)
    match /paid_notes/{noteId} {
      allow read, write: if true;
    }

    // Allow read/write to live_classes
    match /live_classes/{classId} {
      allow read, write: if true;
    }

    // Allow read/write to leaderboard
    match /leaderboard/{entryId} {
      allow read, write: if true;
    }

    // Allow read/write to routine
    match /routine/{routineId} {
      allow read, write: if true;
    }

    // Allow read/write to motivational_quotes
    match /motivational_quotes/{quoteId} {
      allow read, write: if true;
    }

    // Allow read/write to notifications
    match /notifications/{notifId} {
      allow read, write: if true;
    }

    // Allow read/write to settings
    match /settings/{docId} {
      allow read, write: if true;
    }

    // Allow read/write to admin_courses
    match /admin_courses/{courseId} {
      allow read, write: if true;
    }
  }
}

