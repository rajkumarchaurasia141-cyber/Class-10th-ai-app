rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Subjects and chapters are read-only for all users, but only admins can write
    match /subjects/{subjectId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'rajkumarchaurasia141@gmail.com';
      
      match /chapters/{chapterId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.token.email == 'rajkumarchaurasia141@gmail.com';
      }
    }

    // VIP users collection
    match /vip_users/{userEmail} {
      // Anyone can read their own VIP status or if they are admin
      allow read: if request.auth != null && (request.auth.token.email == userEmail || request.auth.token.email == 'rajkumarchaurasia141@gmail.com');
      // Only admin can write to vip_users
      allow write: if request.auth != null && request.auth.token.email == 'rajkumarchaurasia141@gmail.com';
    }
  }
}
